{
  "compilerOptions": {
	"target": "ES2022",
	"module": "NodeNext",
	"moduleResolution": "NodeNext",
	"strict": true,
	"noEmit": true,
	"verbatimModuleSyntax": true,
	"erasableSyntaxOnly": true,
	"rewriteRelativeImportExtensions": true,
	"skipLibCheck": true,
	"types": ["node"],
	"noUnusedLocals": true,
  },
  "include": ["src/**/*.ts"]
}